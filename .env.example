# How the document gets read and the script written. One of:
#   claude-code  (default when no API key) runs the Claude Code CLI on this machine.
#                Claude Code is included in Claude Pro/Max, so there is no per-document
#                cost. Needs `claude` installed and logged in: https://claude.com/claude-code
#   manual       the app shows you a prompt to paste into Claude; you paste the JSON back.
#   api          calls the Claude API with ANTHROPIC_API_KEY (pay per document).
#   mock         keyless smoke test, one plain segment per page.
ANALYZE_PROVIDER=claude-code
# CLAUDE_CODE_BIN=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Narration. piper = free offline voice (run scripts/get-voice.sh once).
# openai = OpenAI TTS (pay per character). silent = no voice.
TTS_PROVIDER=piper
PIPER_MODEL=./data/voices/en-us-lessac-medium.onnx
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx

# Where uploads, pages and videos are stored (mount a volume here in prod)
DATA_DIR=./data

# Optional tuning
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FPS=24
# MAX_UPLOAD_MB=200
# ANALYZE_MAX_IMAGES=40
