# Required: Claude reads the document and writes the script
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Narration. With OPENAI_API_KEY set, OpenAI TTS is used. Without it the
# video is assembled with a silent track (useful for testing).
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# TTS_PROVIDER=silent   # force silent narration

# Where uploads, pages and videos are stored (mount a volume here in prod)
DATA_DIR=/data

# Optional tuning
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# VIDEO_FPS=24
# MAX_UPLOAD_MB=200
# ANALYZE_MAX_IMAGES=40
